<?php
// Contact-form mailer for {{ site.url }} (Simply.com shared hosting, PHP mail()).
// Generated from src/send.njk by Eleventy; edit the template, not _site/send.php.
declare(strict_types=1);

$to     = '{{ site.email }}';
$from   = 'noreply@{{ site.url | replace("https://", "") }}';
$thanks = '/tak/';
$back   = '/#contact';

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    header('Location: ' . $back, true, 303);
    exit;
}

// Honeypot: real visitors never see this field, bots fill it. Pretend success.
if (!empty($_POST['website'])) {
    header('Location: ' . $thanks, true, 303);
    exit;
}

/** One-line, header-safe string (no CR/LF injection). */
function line(string $key, int $max = 200): string
{
    $v = isset($_POST[$key]) && is_string($_POST[$key]) ? $_POST[$key] : '';
    $v = trim(str_replace(["\r", "\n", "\0"], ' ', $v));
    return mb_substr($v, 0, $max, 'UTF-8');
}

/** Multi-line body text, trimmed and capped. */
function text(string $key, int $max = 5000): string
{
    $v = isset($_POST[$key]) && is_string($_POST[$key]) ? $_POST[$key] : '';
    $v = trim(str_replace(["\r\n", "\r", "\0"], ["\n", "\n", ''], $v));
    return mb_substr($v, 0, $max, 'UTF-8');
}

function fail(string $reason): void
{
    global $to, $back;
    http_response_code(500);
    header('Content-Type: text/html; charset=UTF-8');
    $safeReason = htmlspecialchars($reason, ENT_QUOTES, 'UTF-8');
    $safeTo     = htmlspecialchars($to, ENT_QUOTES, 'UTF-8');
    echo '<!DOCTYPE html><html lang="da"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">'
       . '<meta name="robots" content="noindex"><title>Beskeden blev ikke sendt</title>'
       . '<style>body{font-family:system-ui,sans-serif;max-width:560px;margin:80px auto;padding:0 20px;color:#1a1a1a;line-height:1.5}a{color:#2d6a2d}</style>'
       . '</head><body><h1>Beskeden blev ikke sendt</h1><p>' . $safeReason . '</p>'
       . '<p>Send i stedet en mail direkte til <a href="mailto:' . $safeTo . '">' . $safeTo . '</a> '
       . 'eller ring til os på <a href="tel:{{ site.phoneTel }}">{{ site.phoneDisplay }}</a>.</p>'
       . '<p><a href="' . htmlspecialchars($back, ENT_QUOTES, 'UTF-8') . '">Tilbage til formularen</a></p></body></html>';
    exit;
}

$navn       = line('navn');
$virksomhed = line('virksomhed');
$telefon    = line('telefon', 40);
$ydelse     = line('ydelse');
$besked     = text('besked');
$subject    = line('_subject') ?: 'Henvendelse fra {{ site.url | replace("https://", "") }}';

if ($navn === '' || $telefon === '') {
    fail('Navn og telefon skal udfyldes.');
}

$body = implode("\n", [
    'Ny henvendelse via kontaktformularen på {{ site.url | replace("https://", "") }}',
    '',
    'Navn:       ' . $navn,
    'Virksomhed: ' . ($virksomhed !== '' ? $virksomhed : '-'),
    'Telefon:    ' . $telefon,
    'Ydelse:     ' . ($ydelse !== '' ? $ydelse : '-'),
    '',
    'Besked:',
    ($besked !== '' ? $besked : '-'),
    '',
    '--',
    'Sendt ' . date('d-m-Y H:i') . ' fra IP ' . ($_SERVER['REMOTE_ADDR'] ?? '?'),
]);

$headers = implode("\r\n", [
    'From: ' . mb_encode_mimeheader('{{ site.legalName }}', 'UTF-8') . ' <' . $from . '>',
    'MIME-Version: 1.0',
    'Content-Type: text/plain; charset=UTF-8',
    'Content-Transfer-Encoding: 8bit',
    'X-Mailer: PHP/' . PHP_VERSION,
]);

$sent = @mail($to, mb_encode_mimeheader($subject, 'UTF-8'), $body, $headers, '-f' . $from);

if ($sent) {
    header('Location: ' . $thanks, true, 303);
    exit;
}
fail('Beskeden kunne ikke sendes lige nu.');
